# Optional Docker Compose overrides; defaults are for local development only.
# Set a strong private password before using this outside local development.
DB_PASSWORD=local-development-only
APP_PORT=8080

# For ./mvnw spring-boot:run against your own MySQL, export these instead.
# SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/ekote
# SPRING_DATASOURCE_USERNAME=ekote
# SPRING_DATASOURCE_PASSWORD=<your-private-password>
# No Firebase credentials are required by the current application.
